# Eat. Different. — every key the project uses. Copy values into .env (never commit .env).

# Square — SANDBOX until Phase T (developer.squareup.com → your app → Credentials, Sandbox tab)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Filled in Phase T after the webhook subscription is created
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Supabase (Project → Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API Keys)
RESEND_API_KEY=

# Where order / donation alerts go
OWNER_EMAIL=
